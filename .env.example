# Copie para .env e preencha. .env está no .gitignore — nunca commite.

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=

# --- S3 (publicação) ---
# O upload é feito por scripts/s3.py (SigV4 em Python puro). Não precisa da AWS CLI.
S3_BUCKET=
S3_PREFIX=
AWS_REGION=us-east-1
# Credenciais: preencha aqui, OU deixe em branco e use ~/.aws/credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# --- Notificação por e-mail (opcional, Fase 1 item final) ---
NOTIFY_TO=
NOTIFY_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Claude Code headless ---
# Token longo, gerado uma vez por `claude setup-token` (exige assinatura).
# Por que existe: a sessão normal do CLI tem token curto que se renova sozinho,
# e renovar exige rede no momento certo. Se a renovação falhar, o conserto é
# um /login interativo — impossível de fazer de longe. O token longo não
# depende disso. Segundo o próprio CLI, ele é limitado a inferência, então
# teste o pipeline inteiro depois de configurá-lo, não só a autenticação.
#CLAUDE_CODE_OAUTH_TOKEN=

# Descomente APENAS se o binário `claude` não estiver no PATH.
# Deixar definido aqui atrapalha quem passa CLAUDE_BIN na linha de comando.
#CLAUDE_BIN=/usr/local/bin/claude
