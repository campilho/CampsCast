<?xml version="1.0" encoding="UTF-8"?>
<!--
  CampsCast — agendamento via launchd (segunda a sexta, 05:50).

  Instalação:
    cp docs/com.camps.campscast.plist ~/Library/LaunchAgents/
    # ajuste PROJECT_ROOT abaixo para o caminho real do repositório
    launchctl load ~/Library/LaunchAgents/com.camps.campscast.plist

  Conferir / remover:
    launchctl list | grep campscast
    launchctl unload ~/Library/LaunchAgents/com.camps.campscast.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.camps.campscast</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>PROJECT_ROOT/scripts/run_episode.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>PROJECT_ROOT</string>

  <!-- launchd roda com PATH mínimo; inclua onde vivem node/claude/aws. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>50</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>PROJECT_ROOT/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>PROJECT_ROOT/logs/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
